rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    // ── User profiles ─────────────────────────────────────────
    match /users/{uid} {
      allow read: if isLoggedIn();
      allow write: if isOwner(uid);
    }

    // ── Username index ─────────────────────────────────────────
    match /usernames/{username} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }

    // ── Locations (visible users on map) ──────────────────────
    match /locations/{uid} {
      allow read: if isLoggedIn();
      allow write: if isOwner(uid);
    }

    // ── Signals ───────────────────────────────────────────────
    match /signals/{signalId} {
      allow read: if isLoggedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid   == request.auth.uid
      );
      allow create: if isLoggedIn() &&
        request.resource.data.fromUid == request.auth.uid;
      allow update: if isLoggedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid   == request.auth.uid
      );
      allow delete: if isLoggedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid   == request.auth.uid
      );
    }

    // ── Signal cooldowns ──────────────────────────────────────
    match /signalCooldowns/{docId} {
      allow read, write: if isLoggedIn();
    }

    // ── Daily signal counts ───────────────────────────────────
    match /dailySignals/{docId} {
      allow read, write: if isLoggedIn();
    }

    // ── Chats (timer-based anonymous chat) ────────────────────
    match /chats/{chatId} {
      allow read, write: if isLoggedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if isLoggedIn() &&
        request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if isLoggedIn();
      }
    }

    // ── Friend chats (persistent DMs) ─────────────────────────
    match /friendChats/{chatId} {
      allow read, write: if isLoggedIn();

      match /messages/{messageId} {
        allow read, write: if isLoggedIn();
      }
    }

    // ── Friend requests ───────────────────────────────────────
    match /friendRequests/{reqId} {
      allow read: if isLoggedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid   == request.auth.uid
      );
      allow create: if isLoggedIn() &&
        request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isLoggedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid   == request.auth.uid
      );
    }

    // ── Friends list (subcollection per user) ─────────────────
    // acceptFriendRequest writes to BOTH users' lists, so any
    // logged-in user must be allowed to write.
    match /friends/{uid}/friendList/{friendUid} {
      allow read:  if isLoggedIn();
      allow write: if isLoggedIn();
    }

    // ── Posts ─────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isLoggedIn();
      allow delete: if isLoggedIn() &&
        resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isLoggedIn();
        allow create: if isLoggedIn() &&
          request.resource.data.uid == request.auth.uid;
        allow delete: if isLoggedIn() &&
          resource.data.uid == request.auth.uid;
      }

      match /likes/{likeUid} {
        allow read:  if isLoggedIn();
        allow write: if isOwner(likeUid);
      }
    }

    // ── Follow graph ──────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() &&
        request.resource.data.followerId == request.auth.uid;
      allow delete: if isLoggedIn() &&
        resource.data.followerId == request.auth.uid;
    }

    // ── Blocks ─────────────────────────────────────────────────
    match /blocks/{uid}/blockedUsers/{blockedUid} {
      allow read, write: if isOwner(uid);
    }

    // ── Reports ───────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isLoggedIn();
    }

    // ── Matches (legacy) ──────────────────────────────────────
    match /matches/{matchId} {
      allow read, write: if isLoggedIn();
    }

    // ── Glimpses (friends-only stories) ──────────────────────
    match /glimpses/{glimpseId} {
      allow read: if isLoggedIn() && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/friends/$(request.auth.uid)/friendList/$(resource.data.userId))
      );
      allow create: if isLoggedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isLoggedIn() && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/friends/$(request.auth.uid)/friendList/$(resource.data.userId))
      );
      allow delete: if isLoggedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // ── Private vibe text ─────────────────────────────────────
    // Owner-only. No other user or role can read, enforced here.
    match /users/{userId}/private/{document} {
      allow read, write: if isOwner(userId);
    }

    // ── Vibe check requests ───────────────────────────────────
    // Created/updated only by callable Cloud Functions (admin SDK, bypasses rules).
    // Client may read their own requests to drive the UI subscription.
    match /vibeRequests/{requestId} {
      allow read: if isLoggedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId   == request.auth.uid
      );
    }

    // ── Notifications ─────────────────────────────────────────
    // Written by Cloud Functions (admin SDK). Owner may read and
    // mark their own notifications as read (only the read field).
    match /notifications/{userId}/items/{notifId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}
